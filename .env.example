# Sao chép file này thành .env rồi điền giá trị THẬT khi deploy (file .env đã được .gitignore).
# Khi chạy local để demo có thể bỏ qua — docker-compose đã có giá trị mặc định.

# Mật khẩu root của MySQL (đồng thời là mật khẩu backend dùng để kết nối)
DB_PASSWORD=root

# Khoá ký JWT — PHẢI đổi khi deploy thật, tối thiểu 256-bit (32+ ký tự ngẫu nhiên)
JWT_SECRET=doi-secret-nay-trong-production-toi-thieu-256-bit-de-an-pos-convenience-store-2026

# --- PRODUCTION (deploy thật) ---
# Bật profile prod để TẮT seed dữ liệu/tài khoản demo (admin/123456) và bắt buộc JWT_SECRET thật.
SPRING_PROFILES_ACTIVE=prod

# Tài khoản ADMIN đầu tiên — chỉ tạo ở profile prod khi CSDL chưa có người dùng nào.
# Để trống ADMIN_PASSWORD → KHÔNG tạo admin (không có mật khẩu mặc định). Mật khẩu tối thiểu 8 ký tự.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_FULL_NAME=Quản trị viên

# Domain thật cho CORS khi deploy (vd https://pos.cuahang.vn)
# CORS_ORIGINS=https://pos.cuahang.vn
