# CHẠY DEMO: KHÔNG cần tạo file .env — docker-compose đã có sẵn giá trị mặc định
# (admin/123456 + dữ liệu mẫu). Cứ thế `docker compose up -d --build` là chạy.
#
# File này chỉ là MẪU cho lúc deploy thật: sao chép thành .env rồi điền giá trị
# (file .env đã được .gitignore). LƯU Ý: bật prod mà thiếu JWT_SECRET mạnh hoặc
# ADMIN_PASSWORD thì backend sẽ từ chối khởi động / không có tài khoản đăng nhập.

# Mật khẩu root của MySQL (đồng thời là mật khẩu backend dùng để kết nối)
#DB_PASSWORD=doi-mat-khau-nay

# ==================== CHỈ DÙNG KHI DEPLOY THẬT ====================
# Khoá ký JWT — PHẢI đổi, tối thiểu 256-bit (32+ ký tự ngẫu nhiên)
#JWT_SECRET=sinh-chuoi-ngau-nhien-32-ky-tu-tro-len

# Bật profile prod để TẮT seed dữ liệu/tài khoản demo (admin/123456) và bắt buộc JWT_SECRET thật.
#SPRING_PROFILES_ACTIVE=prod

# Tài khoản ADMIN đầu tiên — chỉ tạo ở profile prod khi CSDL chưa có người dùng nào.
# Để trống ADMIN_PASSWORD → KHÔNG tạo admin (không có mật khẩu mặc định). Mật khẩu tối thiểu 8 ký tự.
#ADMIN_USERNAME=admin
#ADMIN_PASSWORD=

# Domain thật cho CORS khi deploy (vd https://pos.cuahang.vn)
#CORS_ORIGINS=https://pos.cuahang.vn

# Bật job đối soát chuyển khoản WEB2M (cần API key thật)
#WEB2M_ENABLED=true
